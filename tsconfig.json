{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["src", "scripts", "test", "*.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test/integration/storage.test.ts",
    "test/integration/slot-identity.test.ts",
    "test/integration/hook-force-claim.test.ts",
    "test/integration/in-band-fence.test.ts",
    "test/integration/run-status-wait.test.ts",
    "test/integration/fuzz-invariants.test.ts",
    "test/integration/atomic-start-hook.test.ts",
    "test/integration/snapshots.test.ts"
  ]
}
